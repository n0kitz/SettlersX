; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SettlersX"
run/main_scene="res://scenes/world/Main.tscn"
config/features=PackedStringArray("4.4", "C#", "Mobile")
config/icon="res://icon.png"

[autoload]

EventBus="*res://src/Core/EventBus.cs"
ResourceDatabase="*res://src/Data/ResourceDatabase.cs"
WorldSim="*res://src/Core/WorldSim.cs"
GameManager="*res://src/Core/GameManager.cs"
InputRouter="*res://src/Views/Core/InputRouter.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

pause_game={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}
step_once={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":46,"key_label":0,"unicode":46,"location":0,"echo":false,"script":null)
]
}
camera_pan={
"deadzone": 0.5,
"events": []
}
camera_zoom_in={
"deadzone": 0.5,
"events": []
}
camera_zoom_out={
"deadzone": 0.5,
"events": []
}
select={
"deadzone": 0.5,
"events": []
}

[dotnet]

project/assembly_name="SettlersX"

[editor]

naming/scene_name_casing=1

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
theme/default_theme_scale=2.0

[rendering]

renderer/rendering_method="mobile"
